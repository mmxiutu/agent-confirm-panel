/**
 * Keep the screen on while the panel is connected.
 * FLAG_KEEP_SCREEN_ON is 128. FLAG_FULLSCREEN is 1024.
 * 5380 is FULLSCREEN + LAYOUT_FULLSCREEN + LAYOUT_STABLE + IMMERSIVE_STICKY.
 */
export function setFullscreen(): void {
  const activity = UTSAndroid.getUniActivity();
  if (activity == null) {
    return;
  }
  activity.runOnUiThread(() => {
    const current = UTSAndroid.getUniActivity();
    if (current == null) {
      return;
    }
    const win = current.getWindow();
    win.addFlags(1024);
    win.getDecorView().setSystemUiVisibility(5380);
  });
}

export function setAwake(on: boolean): void {
  const activity = UTSAndroid.getUniActivity();
  if (activity == null) {
    return;
  }
  activity.runOnUiThread(() => {
    const current = UTSAndroid.getUniActivity();
    if (current == null) {
      return;
    }
    const win = current.getWindow();
    if (on) {
      win.addFlags(128);
    } else {
      win.clearFlags(128);
    }
  });
}
